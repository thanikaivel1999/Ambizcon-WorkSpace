# Leave NEXT_PUBLIC_SUPABASE_URL empty to run in local DEMO mode (browser storage, seeded data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by /api/admin/users and `npm run seed`. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Shared secret for /api/cron/reminders (Vercel Cron sends it as a Bearer token). Generate a long random string.
CRON_SECRET=
